[gd_resource type="Resource" script_class="CardData" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/cards/card_data.gd" id="1_card_data"]
[resource]
script = ExtResource("1_card_data")
id = "spark_copy"
display_name = "Spark Copy"
card_type = "skill"
rarity = "common"
pool_id = "mage"
character_id = "char_mage"
archetype_tags = ["formula", "draw", "discard"]
keyword_tags = ["draw", "discard"]
rewardable = true
shop_weight = 1
reward_weight = 1
unlock_tier = 0
cost = 1
description = "Draw 2. Discard 1 random card."
upgraded_description = "Draw 3. Discard 1 random card."
effects = Array[Dictionary]([{"type": "draw", "amount": 2}, {"type": "discard_random_card", "amount": 1}])
upgraded_effects = Array[Dictionary]([{"type": "draw", "amount": 3}, {"type": "discard_random_card", "amount": 1}])
card_target = "self"
